{
  "name": "catalogo-gol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo estático de modelos 3D — alternativas para brindes corporativos",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:front": "serve -s -l 3000 --no-clipboard .",
    "dev:back": "node ./server/index.js",
    "start": "node ./scripts/dev.mjs",
    "start:front": "serve -s -l 3000 --no-clipboard .",
    "start:back": "node ./server/index.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{js,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,css,html}\"",
    "test": "node --test"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "serve": "^14.2.4"
  }
}
